{
  "manifest_version": 3,
  "name": "Slop Teller",
  "version": "0.2.0",
  "description": "Scores a page for AI tells, marks each one on the page, and exports a fix list as Markdown.",
  "action": {
    "default_title": "Slop Teller: scan this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Scan this page"
    }
  }
}
